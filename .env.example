# All optional - these are the defaults.
SG_DB=data/softgarden.db
# Set to use Postgres instead of SQLite (needs `npm install pg`):
# SG_DB_URL=postgres://softgarden:softgarden@localhost:5432/softgarden
# Dashboard port
SG_PORT=8080
SG_CACHE_DIR=.cc-cache
SG_CONCURRENCY=3
SG_RPS=4
SG_CRAWLS=1
SG_USER_AGENT=softgarden-crawler/1.0 (+https://github.com/<you>/softgarden-crawler)
# Weekly schedule: minute hour day-of-month month day-of-week (default: Mondays 03:17 UTC)
SG_CRON=17 3 * * 1
# Alert when a tenant's open job count falls by more than this fraction (0.3 = 30%)
SG_DROP_THRESHOLD=0.3
